# Firebase web config — copy this file to `.env` and fill it in.
#
#   cp .env.example .env
#
# These six values come from the Firebase console: Project settings → General → Your apps →
# the Web app → "SDK setup and configuration" → Config. See the Gate A setup instructions.
#
# **These are not secrets.** Firebase web config is public by design — it ships inside every
# client bundle and identifies the project rather than authorising anything. What protects
# your data is Firestore security rules (7-12), not the secrecy of these strings. They live
# in `.env` anyway so that staging and production can differ without a code change, which is
# the one thing hardcoding them would prevent.
#
# `EXPO_PUBLIC_`-prefixed variables are loaded automatically by the Expo CLI and inlined into
# the bundle at build time. That prefix is required — without it the value is simply absent at
# runtime. Never put an actual secret behind it.
#
# `.env` is gitignored. This file is committed, as the list of what has to be set.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------------------------
# Cloud sync against the local Firestore emulator (7b). Optional, and off unless set to exactly
# `1`.
#
# Set it, start `npx firebase emulators:start --only firestore`, and the sync engine writes to
# `127.0.0.1:8080` instead of the real project — which is also enough to *enable* the engine, so
# `SYNC_ENABLED` in `src/sync/syncEngine.ts` stays off while you develop. Documents show up in
# the emulator UI at http://localhost:4000/firestore.
#
# Auth still points at the real project, so Google sign-in works normally. Leave this unset for
# anything you want to keep.
EXPO_PUBLIC_FIREBASE_EMULATOR=

# ---------------------------------------------------------------------------------------------
# RevenueCat Web SDK publishable key (8-4), taken from the Stripe config's page in RevenueCat.
# Public by design: it reads offerings and starts a purchase for an already-identified user.
# Sandbox keys start `strp_sb_`; the live key replaces it at 8c.
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
